# Copy to .env.local for local development.
# On Vercel, set the same names under Project Settings → Environment Variables.
#
# Google reviews for "A&E Landworx Septic & Excavation"
# ----------------------------------------------------
# The site already defaults to Place ID ChIJY_jy-dpwGasRzM7D46Z3Njg
# (src/data/business.ts). Leave these blank unless you need to override it.
#
# VITE_GOOGLE_PLACE_ID is baked in at build time and overrides the default
# for the "Leave us a Google review" and "See our reviews on Google" links.
VITE_GOOGLE_PLACE_ID=

# GOOGLE_PLACE_ID is read by /api/reviews. If empty, the server uses
# VITE_GOOGLE_PLACE_ID, then the default Place ID above.
GOOGLE_PLACE_ID=

# Server-only key for the Places API (New). Enable "Places API (New)" on the
# key and do not prefix the name with VITE_ (that would expose it in the browser).
# Without this key, the review buttons still open the Google listing, but the
# page does not show live review text. The site never invents reviews.
GOOGLE_PLACES_API_KEY=
