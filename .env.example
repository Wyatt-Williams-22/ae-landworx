# Copy to .env.local for local development.
# On Vercel, set the same names under Project Settings → Environment Variables.
#
# Google reviews for A&E Landworx (Union County, NC)
# -------------------------------------------------
# Place ID: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
#
# VITE_GOOGLE_PLACE_ID is baked into the site at build time. It powers the
# "Leave us a Google review" button and the "See our reviews on Google" link.
# Leave it blank to send those links to a Google Maps search for
# "A&E Landworx Union County NC".
VITE_GOOGLE_PLACE_ID=

# GOOGLE_PLACE_ID is read by the server function at /api/reviews.
# Set it to the same Place ID. If it is empty, the server falls back to
# VITE_GOOGLE_PLACE_ID.
GOOGLE_PLACE_ID=

# Server-only key for the Places API (New). Enable "Places API (New)" on the
# key and do not prefix the name with VITE_ (that would expose it in the browser).
# Without this key, the Reviews section stays a styled Google link and does
# not show review text. The site never invents reviews.
GOOGLE_PLACES_API_KEY=
